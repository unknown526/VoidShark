# Copy this file to .env and fill in your own keys.
# .env is loaded automatically on startup (via dotenv) and should never be
# committed to version control — add it to .gitignore.

# Groq API key, used by Void AI (the sidebar assistant).
# Get one at https://console.groq.com/keys
VOID_AI_KEY=

# YouTube Data API v3 key, used by the Music panel and the Videos/Short
# videos search tabs. Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Google Custom Search JSON API key + Search Engine ID (cx), used by the
# web/Images/News search tabs. Get these at
# https://programmablesearchengine.google.com/ and
# https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Port the server listens on (optional, defaults to 3000).
PORT=3000
